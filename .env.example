# ============================================================
# SentryGate Door — environment template (NO SECRETS)
# Copy to .env and replace placeholders. Never commit .env.
# ============================================================

# --- Security (required) ---
JWT_SECRET_KEY=change-me-to-a-long-random-secret
HARDWARE_TOKEN=change-me-hardware-token
PIN_PEPPER=change-me-pin-pepper
PIN_PEPPER_ID=v1

# --- Session / CSRF ---
COOKIE_SECURE=false
TRUSTED_PROXY_IPS=127.0.0.1,::1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# --- Redis (compose service: redis) ---
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@redis:6379/0

# --- Database (compose service: db) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=door_control
DATABASE_URL=postgresql+asyncpg://postgres:change-me-db-password@db:5432/door_control

# --- Optional SMS (Melipayamak) — leave empty if unused ---
SMS_USERNAME=
SMS_PASSWORD=
SMS_SENDER_NUMBER=

# --- App tuning ---
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
SEED_DEFAULT_ADMIN=true
ALLOW_OTP_AUTO_REGISTER=false
DEBUG_MODE=false

# --- Publish ports (host) ---
FRONTEND_PUBLISH_PORT=5173
BACKEND_PUBLISH_PORT=8000

# --- Next.js build (empty = same-origin /api and /ws via nginx) ---
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
