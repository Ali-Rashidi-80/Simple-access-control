# ==============================================================================
# SentryGate Environment Configuration Template
# Copy this file to .env and replace placeholder values before running.
# NEVER commit the active .env file containing real secrets to version control.
# ==============================================================================

# --- Core Security & JWT Authentication ---
SECRET_KEY=change-this-to-a-secure-random-64-char-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database Configuration ---
# Default SQLite async URL (embedded local mode)
DATABASE_URL=sqlite+aiosqlite:///./sql_app.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://postgres:your_secure_password@localhost:5432/door_control
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=door_control
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Hardware Node Authentication ---
HARDWARE_TOKEN=your_secure_hardware_pre_shared_key

# --- Google OAuth2 Configuration (Optional) ---
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_USERINFO_URL=https://www.googleapis.com/oauth2/v2/userinfo

# --- SMS OTP Gateway Configuration (MeliPayamak) ---
SMS_USERNAME=your_sms_gateway_username
SMS_PASSWORD=your_sms_gateway_password
SMS_SENDER_NUMBER=your_sms_sender_number

# --- Frontend Application Settings ---
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/frontend
