# ==============================================================================
# SentryGate .gitignore
# ==============================================================================

# --- Secrets & Environment Configurations ---
.env
.env.*
!.env.example
micro-python-esp32/config.json
!.micro-python-esp32/config.example.json
commit_msg.txt

# --- Database & Storage Engines ---
*.db
*.db-journal
*.sqlite
*.sqlite3
data/*.db
backend/data/*.db

# --- Python & Bytecode Caches ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Static Type Checker & Linter Caches ---
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover

# --- Frontend Node & Build Artifacts ---
node_modules/
frontend/dist/
frontend/build/
.npm
*.tsbuildinfo
frontend.zip

# --- Testing & E2E Logs & Artifacts ---
e2e/test-results/
e2e/playwright-report/
e2e/output*.log
*.log

# --- IDE, OS & Shell Metadata ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
.bashrc
.bash_logout
.profile
.cloud-locale-test.skip
fix_env.py

