import pytest
from app.models import User, AccessLog
from sqlalchemy import select
from fastapi.testclient import TestClient
from app.main import app

# Note: WebSocket testing with TestClient is limited. 
# We can use httpx or websockets library, or Starlette's TestClient.
# app.test_client() supports websockets.

@pytest.mark.asyncio
async def test_full_access_flow(client, db_session):
    # 1. Create a User
    # We can do this via DB directly or via API if exists. Assuming DB for now.
    user = User(name="Test User", rfid_tag="12345", role="user")
    db_session.add(user)
    await db_session.commit()
    
    # Verify user created
    result = await db_session.execute(select(User).where(User.rfid_tag == "12345"))
    created_user = result.scalar_one_or_none()
    assert created_user is not None
    assert created_user.name == "Test User"
    
    # 2. Simulate Hardware WebSocket Connection and Message
    # TestClient from starlette handles websockets
    with TestClient(app) as ws_client:
        with ws_client.websocket_connect("/ws/hardware") as ws_hardware:
            
            # Send Scan Data
            ws_hardware.send_json({
                "rfid": "12345",
                "temperature": 25.5,
                "is_duress": False
            })
            
            # 3. Verify OPEN command received by hardware
            # The hardware client itself should receive the command
            response = ws_hardware.receive_json()
            assert response["cmd"] == "OPEN"
            
            # 4. Check Database for Access Log
            # Wait a bit or check immediately?
            result = await db_session.execute(select(AccessLog).where(AccessLog.user_name == "Test User"))
            log_entries = result.scalars().all()
            assert len(log_entries) > 0
            latest_log = log_entries[-1]
            assert latest_log.action == "GRANTED"
            assert latest_log.temperature == 25.5

@pytest.mark.asyncio
async def test_unknown_tag_flow(client, db_session):
    with TestClient(app) as ws_client:
        with ws_client.websocket_connect("/ws/hardware") as ws_hardware:
            # Send Unknown Tag
            ws_hardware.send_json({
                "rfid": "99999",
                "temperature": 20.0
            })
            
            # Verify DENY command
            response = ws_hardware.receive_json()
            assert response["cmd"] == "DENY"
            
            # Verify Log
            result = await db_session.execute(select(AccessLog).where(AccessLog.user_name == "Unknown"))
            log_entries = result.scalars().all()
            assert len(log_entries) > 0
            assert log_entries[-1].action == "DENIED"

