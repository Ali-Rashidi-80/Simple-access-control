import pytest
from httpx import AsyncClient, ASGITransport
from sqlalchemy.ext.asyncio import create_async_engine, AsyncSession
from sqlalchemy.orm import sessionmaker
from fastapi.testclient import TestClient
from starlette.testclient import TestClient as StarletteTestClient
import pytest_asyncio

from app.main import app
from app.database import Base, get_db
from app import models

TEST_DATABASE_URL = "sqlite+aiosqlite:///:memory:"

engine = create_async_engine(TEST_DATABASE_URL, connect_args={"check_same_thread": False})
TestingSessionLocal = sessionmaker(class_=AsyncSession, autoflush=False, bind=engine, expire_on_commit=False)

# PATCH THE REAL DATABASE ENGINE
from app import database
database.engine = engine
database.SessionLocal = TestingSessionLocal

async def override_get_db():
    async with TestingSessionLocal() as session:
        yield session

app.dependency_overrides[get_db] = override_get_db

@pytest_asyncio.fixture(scope="function")
async def async_client():
    async with engine.begin() as conn:
        await conn.run_sync(Base.metadata.create_all)
    async with AsyncClient(transport=ASGITransport(app=app), base_url="http://test") as ac:
        yield ac
    async with engine.begin() as conn:
        await conn.run_sync(Base.metadata.drop_all)

@pytest_asyncio.fixture(scope="function")
async def db_session():
    async with TestingSessionLocal() as session:
        yield session

@pytest.mark.asyncio
async def test_authorized_access_flow(async_client, db_session):
    user = models.User(name="Authorized Guy", rfid_tag="0xAUTH", role="user")
    db_session.add(user)
    await db_session.commit()
    
    client = StarletteTestClient(app) # Use synchronous wrapper for WS tests
    with client.websocket_connect("/ws/hardware") as ws_hw, \
         client.websocket_connect("/ws/frontend") as ws_fe:
        
        ws_hw.send_json({"type": "scan", "rfid": "0xAUTH", "temperature": 25.5})
        
        cmd = ws_hw.receive_json()
        assert cmd["cmd"] == "OPEN"
        
        log = ws_fe.receive_json()
        assert log["type"] == "ACCESS_LOG"
        assert log["data"]["user_name"] == "Authorized Guy"
        assert log["data"]["action"] == "GRANTED"

@pytest.mark.asyncio
async def test_unauthorized_access_flow(async_client):
    client = StarletteTestClient(app)
    with client.websocket_connect("/ws/hardware") as ws_hw, \
         client.websocket_connect("/ws/frontend") as ws_fe:
        
        ws_hw.send_json({"type": "scan", "rfid": "0xUNKNOWN", "temperature": 25.5})
        
        cmd = ws_hw.receive_json()
        assert cmd["cmd"] == "DENY"
        
        log = ws_fe.receive_json()
        assert log["type"] == "ACCESS_LOG"
        assert log["data"]["action"] == "DENIED"
        
        alert = ws_fe.receive_json()
        assert alert["type"] == "UNKNOWN_TAG"
        assert alert["uid"] == "0xUNKNOWN"

@pytest.mark.asyncio
async def test_remote_unlock_flow(async_client):
    client = StarletteTestClient(app)
    with client.websocket_connect("/ws/hardware") as ws_hw, \
         client.websocket_connect("/ws/frontend") as ws_fe:
        
        ws_fe.send_json({"cmd": "OPEN"})
        cmd = ws_hw.receive_json()
        assert cmd["cmd"] == "OPEN"
