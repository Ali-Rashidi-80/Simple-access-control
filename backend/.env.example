# ============================================================
# SentryGate backend — environment template (NO SECRETS)
# Copy to backend/.env for local uvicorn. Never commit secrets.
# ============================================================

JWT_SECRET_KEY=change-me-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
SEED_DEFAULT_ADMIN=true
ALLOW_OTP_AUTO_REGISTER=false
DEBUG_MODE=false

DATABASE_URL=postgresql+asyncpg://postgres:change-me-db-password@127.0.0.1:5432/door_control
# Local SQLite alternative:
# DATABASE_URL=sqlite+aiosqlite:///./sql_app.db

REDIS_URL=redis://:change-me-redis-password@127.0.0.1:6379/0
HARDWARE_TOKEN=change-me-hardware-token
FRONTEND_URL=http://localhost:3100
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100,http://localhost:5173

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3100/auth/google/callback

SMS_USERNAME=
SMS_PASSWORD=
SMS_SENDER_NUMBER=
