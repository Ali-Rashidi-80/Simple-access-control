# ============================================================
# Local DR / mirror stack — template (NO SECRETS)
# Copy to .env.local-mirror
# Usage:
#   docker compose -p sentrygate-mirror -f docker-compose.local-mirror.yml --env-file .env.local-mirror up -d --build
# ============================================================

LOCAL_DB_NAME=door_control
LOCAL_DB_USER=postgres
LOCAL_DB_PASSWORD=change-me-mirror-db-password
LOCAL_DB_PORT=55433

REDIS_PASSWORD=change-me-mirror-redis-password
LOCAL_REDIS_PORT=56380

# --- Security & session ---
JWT_SECRET_KEY=change-me-mirror-jwt-secret
HARDWARE_TOKEN=change-me-mirror-hardware-token
PIN_PEPPER=change-me-mirror-pin-pepper
PIN_PEPPER_ID=v1
COOKIE_SECURE=false
TRUSTED_PROXY_IPS=127.0.0.1,::1

SEED_DEFAULT_ADMIN=true
ALLOW_OTP_AUTO_REGISTER=false
DEBUG_MODE=true
FRONTEND_URL=http://127.0.0.1:38122
CORS_ORIGINS=http://127.0.0.1:38122,http://localhost:38122

FRONTEND_PUBLISH_PORT=38122
BACKEND_PUBLISH_PORT=38121

# Build-time Next.js frontend (empty = same-origin /api and /ws via nginx)
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=

# Optional image overrides
LOCAL_POSTGRES_IMAGE=mirror2.chabokan.net/postgres:16-bookworm
LOCAL_REDIS_IMAGE=mirror2.chabokan.net/redis:latest
