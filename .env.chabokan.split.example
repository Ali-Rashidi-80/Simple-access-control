# ============================================================
# Chabokan split deploy — panel ENV checklist (NO SECRETS)
# Fill in Chabokan panel -> each service -> Environment variables.
# ============================================================

## sentrygate-backend (FastAPI)

JWT_SECRET_KEY=change-me-to-a-long-random-secret
HARDWARE_TOKEN=change-me-hardware-token
PIN_PEPPER=change-me-pin-pepper
PIN_PEPPER_ID=v1
COOKIE_SECURE=true
TRUSTED_PROXY_IPS=127.0.0.1,::1

SEED_DEFAULT_ADMIN=false
ALLOW_OTP_AUTO_REGISTER=false
DEBUG_MODE=false
FRONTEND_URL=https://your-domain.example.com
CORS_ORIGINS=https://your-domain.example.com

# Managed PostgreSQL (example host from Chabokan panel)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/door_control
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=door_control

# Managed Redis
REDIS_URL=redis://:PASSWORD@HOST:PORT/0

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.example.com/auth/google/callback
SMS_USERNAME=
SMS_PASSWORD=
SMS_SENDER_NUMBER=

## sentrygate-frontend (Next.js static export + Nginx)

# Build args (set at image build / panel build settings)
# NEXT_PUBLIC_API_URL=   (empty = same-origin /api via nginx)
# NEXT_PUBLIC_WS_URL=    (empty = same-origin /ws via nginx)

## sentrygate-postgresql (managed or in-stack)

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=door_control

## sentrygate-redis (managed or in-stack)

REDIS_PASSWORD=
